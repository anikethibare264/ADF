											"physicalType": "String"
										},
										"sink": {
											"name": "Academic_Level",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Country",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Country",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Avg_Daily_Usage_Hours",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Avg_Daily_Usage_Hours",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Most_Used_Platform",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Most_Used_Platform",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Affects_Academic_Performance",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Affects_Academic_Performance",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Sleep_Hours_Per_Night",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Sleep_Hours_Per_Night",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Mental_Health_Score",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Mental_Health_Score",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Relationship_Status",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Relationship_Status",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Conflicts_Over_Social_Media",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Conflicts_Over_Social_Media",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Addicted_Score",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Addicted_Score",
											"type": "String",
											"physicalType": "String"
										}
									}
								],
